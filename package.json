{
  "name": "maestro-mobile-quality-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Readable Android mobile automation flows with Maestro and CI-ready validation.",
  "scripts": {
    "validate": "node scripts/validate-flows.mjs",
    "test:smoke": "maestro test --include-tags=smoke .maestro/flows",
